{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "2023-only layered bullet chart: rated usefulness of seven established tracker features, with 2023 median benchmark.",
  "background": "white",
  "width": "container",
  "height": 360,
  "data": {
    "url": "data/jmir-features.csv",
    "format": {
      "type": "csv",
      "parse": {
        "percent": "number"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "height": 24,
        "color": "#EDF2F0"
      },
      "encoding": {
        "x": {
          "datum": 100,
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": {
            "title": "Respondents rating the feature useful (%)",
            "values": [
              0,
              20,
              40,
              60,
              80,
              100
            ]
          }
        },
        "x2": {
          "datum": 0
        },
        "y": {
          "field": "feature",
          "type": "nominal",
          "sort": [
            "Heart rate",
            "Steps",
            "Active minutes",
            "Sleep",
            "Energy burned",
            "Energy consumed",
            "Stairs"
          ],
          "axis": {
            "title": null,
            "labelLimit": 125,
            "labelPadding": 9
          }
        }
      }
    },
    {
      "mark": {
        "type": "bar",
        "height": 14
      },
      "encoding": {
        "x": {
          "field": "percent",
          "type": "quantitative"
        },
        "x2": {
          "datum": 0
        },
        "color": {
          "condition": {
            "test": "datum.feature === 'Heart rate'",
            "value": "#007F77"
          },
          "value": "#82B9B0"
        },
        "tooltip": [
          {
            "field": "feature",
            "type": "nominal",
            "title": "Feature"
          },
          {
            "field": "percent",
            "type": "quantitative",
            "title": "Rated useful (%)",
            "format": ".1f"
          }
        ],
        "y": {
          "field": "feature",
          "type": "nominal",
          "sort": [
            "Heart rate",
            "Steps",
            "Active minutes",
            "Sleep",
            "Energy burned",
            "Energy consumed",
            "Stairs"
          ],
          "axis": {
            "title": null,
            "labelLimit": 125,
            "labelPadding": 9
          }
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "benchmark": 59.9
          }
        ]
      },
      "mark": {
        "type": "rule",
        "stroke": "#C46D47",
        "strokeWidth": 2,
        "strokeDash": [
          5,
          4
        ]
      },
      "encoding": {
        "x": {
          "field": "benchmark",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "benchmark",
            "type": "quantitative",
            "title": "2023 median (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 7,
        "font": "DM Sans",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#254349"
      },
      "encoding": {
        "x": {
          "field": "percent",
          "type": "quantitative"
        },
        "text": {
          "field": "percent",
          "type": "quantitative",
          "format": ".1f"
        },
        "y": {
          "field": "feature",
          "type": "nominal",
          "sort": [
            "Heart rate",
            "Steps",
            "Active minutes",
            "Sleep",
            "Energy burned",
            "Energy consumed",
            "Stairs"
          ],
          "axis": {
            "title": null,
            "labelLimit": 125,
            "labelPadding": 9
          }
        }
      }
    }
  ],
  "config": {
    "font": "DM Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#566C70",
      "titleColor": "#254349",
      "gridColor": "#E8EFEF",
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12
    }
  }
}
